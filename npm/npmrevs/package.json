{
  "name": "@codesweep-ai/npmrevs",
  "version": "0.0.0",
  "description": "Package, resolve and serve each revision's build of an npm package, so a team of AI coding agents can install work in progress.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codesweep-ai/npmrevs.git",
    "directory": "npm/npmrevs"
  },
  "homepage": "https://github.com/codesweep-ai/npmrevs#readme",
  "bugs": {
    "url": "https://github.com/codesweep-ai/npmrevs/issues"
  },
  "keywords": [
    "ai-agents",
    "developer-tools",
    "golang",
    "npm",
    "npm-registry",
    "oci"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "cs-npmrevs": "bin/cs-npmrevs.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "index.mjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "optionalDependencies": {
    "@codesweep-ai/npmrevs-darwin-arm64": "0.0.0",
    "@codesweep-ai/npmrevs-darwin-x64": "0.0.0",
    "@codesweep-ai/npmrevs-linux-arm64": "0.0.0",
    "@codesweep-ai/npmrevs-linux-x64": "0.0.0"
  }
}
